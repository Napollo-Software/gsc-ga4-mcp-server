# Google Workload Identity Federation
GCP_PROJECT_NUMBER=123456789012
GCP_SERVICE_ACCOUNT_EMAIL=gsc-ga4-mcp@your-project-id.iam.gserviceaccount.com
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel

# Protect the MCP endpoint with a long random bearer token.
MCP_BEARER_TOKEN=replace-with-a-long-random-value

# Pair each Search Console property with its GA4 numeric property ID.
ACCOUNT_MAP_JSON=[{"id":"example","name":"Example Site","gscSiteUrl":"sc-domain:example.com","ga4PropertyId":"123456789"}]

# Optional safety limits
DEFAULT_COMPARISON_DAYS=28
MAX_ACCOUNTS_PER_SCAN=25
MIN_BASELINE=20
